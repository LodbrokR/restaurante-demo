---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-CL" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Kumo Sushi | Experiencia Omakase y Sushi de Autor en Santiago." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;800&family=Noto+Serif:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
		<title>{title} | Kumo Sushi</title>
	</head>
	<body class="font-['Outfit'] bg-stone-50 text-stone-600 antialiased selection:bg-rose-500 selection:text-white flex flex-col min-h-screen">
		<header class="fixed w-full top-0 z-50 bg-stone-50/80 backdrop-blur-xl border-b border-stone-200/50 transition-all duration-500">
			<div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
				<a href="/" class="flex items-center gap-2 group">
					<span class="font-['Noto_Serif'] font-bold text-2xl tracking-widest text-stone-900 uppercase group-hover:text-rose-600 transition-colors duration-500">Kumo<span class="text-rose-600 font-light mx-1">雲</span></span>
				</a>
				<nav class="hidden md:flex items-center gap-10">
					<ul class="flex items-center gap-8 text-sm font-medium text-stone-500 tracking-wide">
						<li><a href="/" class="hover:text-stone-900 hover:scale-105 transform transition-all">Inicio</a></li>
						<li><a href="/menu" class="hover:text-stone-900 hover:scale-105 transform transition-all">Omakase</a></li>
						<li><a href="/nosotros" class="hover:text-stone-900 hover:scale-105 transform transition-all">Filosofía</a></li>
					</ul>
					<a href="/reservas" class="group relative px-6 py-2.5 font-medium text-sm tracking-widest uppercase overflow-hidden bg-stone-900 text-white rounded-sm shadow-xl transition-all hover:shadow-rose-500/20">
						<div class="absolute inset-0 w-0 bg-rose-600 transition-all duration-[250ms] ease-out group-hover:w-full"></div>
						<span class="relative">Reservar Mesa</span>
					</a>
				</nav>
			</div>
		</header>
		<main class="flex-grow pt-20 overflow-x-hidden">
			<slot />
		</main>
		<footer class="bg-stone-900 text-stone-400 pt-20 pb-10 mt-auto border-t border-stone-800">
			<div class="max-w-7xl mx-auto px-6 flex flex-col items-center text-center">
				<div class="mb-8 hover:scale-105 transition-transform duration-500 cursor-pointer">
					<span class="font-['Noto_Serif'] font-bold text-4xl tracking-widest text-white uppercase">Kumo<span class="text-rose-500 font-light mx-2">雲</span></span>
				</div>
				<div class="text-sm text-stone-400 mb-10 space-y-3 font-light tracking-wide">
					<p class="hover:text-stone-300 transition-colors">Av. Nueva Costanera 3900, Vitacura, Santiago</p>
					<p>Martes a Sábado: 19:30 - 23:30 | Domingo: 13:00 - 16:30</p>
				</div>
				<div class="flex gap-6 mb-12">
					<a href="#" class="w-10 h-10 rounded-full border border-stone-700 flex items-center justify-center hover:bg-rose-600 hover:border-rose-600 hover:text-white transition-all duration-300">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
					</a>
				</div>
				<p class="text-xs text-stone-600 uppercase tracking-widest">&copy; 2026 Kumo Sushi. El Arte del Omotenashi.</p>
			</div>
		</footer>
	</body>
</html>
