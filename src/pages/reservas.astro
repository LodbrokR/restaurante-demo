---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Reservas">
    <section class="pt-32 pb-24 bg-stone-50 min-h-[80vh] flex items-center">
        <div class="max-w-2xl mx-auto px-6 w-full">
            <div class="text-center mb-10">
                <span class="text-rose-600 font-bold tracking-widest uppercase text-sm mb-2 block">Kumo Sushi</span>
                <h1 class="text-4xl md:text-5xl font-['Noto_Serif'] font-bold text-stone-900 mb-4">Reserva tu mesa</h1>
                <p class="text-stone-500 font-light text-lg">Vive la experiencia Omakase. Asegura tu lugar en nuestro salón exclusivo.</p>
            </div>
            
            <div class="bg-white p-8 md:p-10 rounded-2xl shadow-xl shadow-stone-200/50 border border-stone-100">
                <form id="reservaForm" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Fecha</label>
                            <input name="Fecha" type="date" required class="w-full border-b-2 border-stone-200 py-2 bg-transparent focus:border-rose-500 transition-colors outline-none font-medium text-stone-800">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Hora</label>
                            <select name="Hora" required class="w-full border-b-2 border-stone-200 py-2 bg-transparent focus:border-rose-500 transition-colors outline-none font-medium text-stone-800">
                                <option value="" disabled selected>Seleccionar hora</option>
                                <option>19:30</option>
                                <option>20:00</option>
                                <option>20:30</option>
                                <option>21:00</option>
                                <option>21:30</option>
                                <option>22:00</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Nombre completo</label>
                            <input name="Nombre" type="text" placeholder="Ej: Juan Pérez" required class="w-full border-b-2 border-stone-200 py-2 bg-transparent focus:border-rose-500 transition-colors outline-none font-medium text-stone-800">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Comensales</label>
                            <select name="Personas" required class="w-full border-b-2 border-stone-200 py-2 bg-transparent focus:border-rose-500 transition-colors outline-none font-medium text-stone-800">
                                <option value="1">1 Persona</option>
                                <option value="2" selected>2 Personas</option>
                                <option value="3">3 Personas</option>
                                <option value="4">4 Personas</option>
                                <option value="5">5 Personas</option>
                                <option value="6">6 Personas</option>
                                <option value="7+">7+ Personas (Requiere confirmación)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Teléfono</label>
                            <input name="Telefono" type="tel" placeholder="+56 9 XXXX XXXX" required class="w-full border-b-2 border-stone-200 py-2 bg-transparent focus:border-rose-500 transition-colors outline-none font-medium text-stone-800">
                        </div>
                        <div>
                            <label class="block text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Email</label>
                            <input name="Email" type="email" placeholder="correo@ejemplo.cl" required class="w-full border-b-2 border-stone-200 py-2 bg-transparent focus:border-rose-500 transition-colors outline-none font-medium text-stone-800">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs uppercase tracking-widest text-stone-500 font-semibold mb-2">Comentarios Especiales (Alergias, celebraciones)</label>
                        <textarea name="Comentarios" rows="2" placeholder="Opcional..." class="w-full border-b-2 border-stone-200 py-2 bg-transparent focus:border-rose-500 transition-colors outline-none font-medium text-stone-800 resize-none"></textarea>
                    </div>

                    <div class="pt-4">
                        <button type="submit" id="submitBtn" class="w-full bg-stone-900 hover:bg-rose-600 text-white font-medium tracking-widest uppercase text-sm py-4 rounded-sm transition-all shadow-xl hover:shadow-rose-500/20">
                            Confirmar Reserva
                        </button>
                        <p id="formStatus" class="text-sm font-bold text-emerald-600 hidden text-center mt-4">¡Reserva solicitada! Te confirmaremos a la brevedad.</p>
                    </div>
                </form>
            </div>
        </div>
    </section>
</Layout>

<script>
	const form = document.getElementById('reservaForm') as HTMLFormElement;
	const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
	const formStatus = document.getElementById('formStatus');

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			
			const originalText = submitBtn.innerText;
			submitBtn.innerText = 'PROCESANDO...';
			submitBtn.disabled = true;

			try {
				const formData = new FormData(form);
				const res = await fetch('/api/send-email', {
					method: 'POST',
					body: formData
				});

				if (res.ok) {
					form.reset();
					formStatus?.classList.remove('hidden');
					setTimeout(() => {
						formStatus?.classList.add('hidden');
					}, 6000);
				} else {
					alert('Hubo un error al procesar tu reserva. Inténtalo nuevamente.');
				}
			} catch (error) {
				alert('Hubo un error de conexión.');
			} finally {
				submitBtn.innerText = originalText;
				submitBtn.disabled = false;
			}
		});
	}
</script>
