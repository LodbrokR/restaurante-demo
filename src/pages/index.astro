---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experiencia Sushi">
	<!-- Hero Section -->
	<section class="relative h-[92vh] flex items-center justify-center overflow-hidden">
		<!-- Dynamic Background -->
		<div class="absolute inset-0 z-0 bg-stone-200">
			<img src="/images/sushi_hero.png" alt="Kumo Sushi" class="absolute inset-0 w-full h-full object-cover opacity-70 mix-blend-multiply scale-105 animate-[pulse_20s_ease-in-out_infinite_alternate]" />
			<!-- Elegant Gradient Fade -->
			<div class="absolute inset-0 bg-gradient-to-t from-stone-50 via-stone-50/60 to-transparent"></div>
			<div class="absolute inset-0 bg-gradient-to-r from-stone-50/50 to-transparent"></div>
		</div>
		
		<div class="relative z-10 text-center px-6 max-w-5xl mx-auto transform translate-y-8 animate-[fade-in-up_1s_ease-out]">
			<span class="text-rose-600 uppercase tracking-[0.4em] text-xs font-bold mb-6 block drop-shadow-sm">Modern Omotenashi</span>
			<h1 class="text-6xl md:text-8xl font-['Noto_Serif'] font-bold text-stone-900 mb-8 tracking-tighter leading-none drop-shadow-xl">
				El Arte de la <br/>
				<span class="italic font-light text-stone-800">Precisión</span>
			</h1>
			<p class="text-xl md:text-2xl text-stone-600 mb-12 font-light max-w-2xl mx-auto leading-relaxed drop-shadow-sm">
				Una travesía culinaria donde la técnica ancestral japonesa se encuentra con el océano Pacífico.
			</p>
			<a href="/reservas" class="group inline-flex items-center gap-3 bg-stone-900 text-white px-10 py-5 font-medium uppercase tracking-[0.2em] text-sm hover:bg-rose-600 transition-all duration-500 shadow-2xl hover:shadow-rose-500/30 hover:-translate-y-1">
				<span>Comenzar el Viaje</span>
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-2 transition-transform duration-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
			</a>
		</div>
	</section>

	<!-- Dynamic Bento Grid Section -->
	<section class="py-32 max-w-7xl mx-auto px-6">
		<div class="text-center mb-20">
			<span class="text-rose-600 font-bold tracking-widest uppercase text-sm mb-2 block">Nuestra Carta</span>
			<h2 class="text-4xl md:text-5xl font-['Noto_Serif'] font-bold text-stone-900">Pura Excelencia</h2>
			<div class="w-12 h-0.5 bg-rose-500 mx-auto mt-6"></div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-4 gap-6 auto-rows-[340px]">
			
			<!-- Bento 1: Omakase (Large) -->
			<div class="md:col-span-2 row-span-2 relative group overflow-hidden bg-white border border-stone-200/60 flex items-end p-10 shadow-sm hover:shadow-2xl transition-all duration-700 rounded-sm">
				<div class="absolute inset-0 transition-transform duration-1000 group-hover:scale-110">
					<img src="/images/sushi_hiramasa.png" alt="Omakase" class="w-full h-full object-cover opacity-90" />
				</div>
				<!-- Darker gradient for text readability -->
				<div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-stone-900/40 to-transparent opacity-90 group-hover:opacity-80 transition-opacity duration-700"></div>
				
				<div class="relative z-10 w-full transform transition-transform duration-500 group-hover:-translate-y-2">
					<div class="flex justify-between items-center mb-4">
						<span class="bg-rose-600/90 backdrop-blur-sm text-white text-[10px] px-3 py-1.5 uppercase tracking-[0.2em] font-bold">Chef's Choice</span>
					</div>
					<h3 class="text-4xl font-['Noto_Serif'] font-bold text-white mb-3 drop-shadow-md">Experiencia Omakase</h3>
					<p class="text-stone-300 mb-8 max-w-sm font-light leading-relaxed opacity-0 group-hover:opacity-100 transition-opacity duration-700 delay-100 h-0 group-hover:h-auto overflow-hidden">15 tiempos dictados por la pesca del día. Nigiris de autor, cortes premium y wagyu sellado.</p>
					
					<a href="/menu" class="inline-flex items-center gap-2 text-rose-300 font-medium tracking-widest text-sm uppercase hover:text-white transition-colors">
						<span class="border-b border-rose-300/30 group-hover:border-rose-300 pb-1 transition-colors">Ver Menú</span>
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
					</a>
				</div>
			</div>

			<!-- Bento 2: Wagyu (Medium) -->
			<div class="md:col-span-2 relative group overflow-hidden bg-stone-900 flex items-end p-8 shadow-sm hover:shadow-xl transition-all duration-500 rounded-sm">
				<div class="absolute inset-0 transition-transform duration-1000 group-hover:scale-105 opacity-60 mix-blend-luminosity group-hover:mix-blend-normal">
					<img src="/images/sushi_wagyu.png" alt="Wagyu" class="w-full h-full object-cover" />
				</div>
				<div class="absolute inset-0 bg-gradient-to-t from-stone-950 to-transparent opacity-90"></div>
				<div class="relative z-10">
					<h3 class="text-2xl font-['Noto_Serif'] text-white mb-2 group-hover:text-rose-400 transition-colors duration-300">A5 Wagyu Nigiri</h3>
					<p class="text-stone-400 font-light text-sm">Sellado al carbón binchotan, sal de mar ahumada.</p>
				</div>
			</div>

			<!-- Bento 3: Minimal Text -->
			<div class="relative bg-white border border-stone-200/60 p-8 flex flex-col justify-center items-center text-center group overflow-hidden shadow-sm hover:shadow-lg transition-all duration-500 rounded-sm">
				<div class="absolute inset-0 bg-rose-50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
				<div class="relative z-10">
					<div class="w-14 h-14 border border-rose-200 rounded-full flex items-center justify-center text-rose-600 mx-auto mb-5 group-hover:scale-110 group-hover:bg-rose-600 group-hover:text-white transition-all duration-500">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
					</div>
					<h3 class="text-stone-900 font-bold tracking-wide mb-2">Hospitalidad</h3>
					<p class="text-stone-500 text-sm font-light">Atención impecable en cada detalle.</p>
				</div>
			</div>

			<!-- Bento 4: Maki (Small Image) -->
			<div class="relative bg-stone-100 border border-stone-200/60 overflow-hidden group shadow-sm hover:shadow-lg transition-all duration-500 rounded-sm flex items-end p-8">
				<div class="absolute inset-0 transition-transform duration-[1.5s] group-hover:scale-110">
					<img src="/images/sushi_maki.png" alt="Maki" class="w-full h-full object-cover opacity-80" />
				</div>
				<div class="absolute inset-0 bg-gradient-to-t from-stone-900 via-transparent to-transparent opacity-70"></div>
				<div class="relative z-10 w-full text-center transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
					<h3 class="text-white font-medium tracking-widest text-sm uppercase">Signature Rolls</h3>
				</div>
			</div>

		</div>
	</section>

	<!-- Interactive Philosophy Section -->
	<section class="py-24 bg-white border-t border-stone-200/50">
		<div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
			<div class="order-2 md:order-1 relative group">
				<div class="absolute -inset-4 border border-rose-200/60 translate-x-4 translate-y-4 transition-transform duration-500 group-hover:translate-x-2 group-hover:translate-y-2"></div>
				<img src="/images/sushi_chef.png" alt="Chef" class="relative z-10 w-full aspect-[4/5] object-cover shadow-2xl grayscale-[30%] group-hover:grayscale-0 transition-all duration-700" />
			</div>
			<div class="order-1 md:order-2 space-y-8">
				<h2 class="text-4xl md:text-5xl font-['Noto_Serif'] text-stone-900 leading-tight">La Devoción por el <span class="text-rose-600 italic">Detalle</span></h2>
				<p class="text-lg text-stone-600 font-light leading-relaxed">
					En Kumo, entendemos el sushi no como una receta, sino como una disciplina. Cada corte refleja años de práctica, cada grano de arroz está sazonado con precisión.
				</p>
				<p class="text-stone-500 font-light leading-relaxed">
					Trabajamos en colaboración directa con pescadores artesanales del sur de Chile, garantizando sustentabilidad y frescura absoluta en nuestra barra.
				</p>
				<div class="pt-6">
					<a href="/nosotros" class="inline-flex items-center gap-2 text-stone-900 font-bold uppercase tracking-widest text-sm hover:text-rose-600 transition-colors group">
						Nuestra Historia
						<span class="block w-8 h-[1px] bg-stone-900 group-hover:bg-rose-600 group-hover:w-12 transition-all duration-300 ml-2"></span>
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
