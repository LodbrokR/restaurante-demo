---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experiencia Culinaria">
	<!-- Hero Section -->
	<section class="relative h-[90vh] flex items-center justify-center overflow-hidden">
		<div class="absolute inset-0 bg-zinc-900 z-0">
			<img src="/images/hero_restaurante.png" alt="Restaurante" class="absolute inset-0 w-full h-full object-cover opacity-40" />
			<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/60 to-transparent"></div>
		</div>
		
		<div class="relative z-10 text-center px-6 max-w-4xl mx-auto transform translate-y-10">
			<span class="text-brand-500 uppercase tracking-[0.3em] text-sm font-semibold mb-4 block">Gastronomía Chilena Contemporánea</span>
			<h1 class="text-5xl md:text-8xl font-extrabold text-white mb-6 tracking-tighter uppercase leading-none">
				El Sabor<br/>de la <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-500 to-amber-600">Tierra</span>
			</h1>
			<p class="text-xl text-zinc-400 mb-10 font-light max-w-2xl mx-auto">
				Redescubre los ingredientes nativos de Chile a través del fuego, la técnica y la pasión en el corazón de Vitacura.
			</p>
			<a href="/reservas" class="inline-block bg-white text-zinc-950 px-10 py-4 font-bold uppercase tracking-wider text-sm hover:bg-brand-500 hover:text-white transition-colors duration-300">
				Asegurar mi mesa
			</a>
		</div>
	</section>

	<!-- Bento Grid Section -->
	<section class="py-24 max-w-7xl mx-auto px-6">
		<div class="grid grid-cols-1 md:grid-cols-4 gap-4 auto-rows-[300px]">
			
			<!-- Promo Bento -->
			<div class="md:col-span-2 row-span-2 relative group overflow-hidden bg-zinc-900 border border-zinc-800 flex items-end p-8">
				<div class="absolute inset-0 transition-transform duration-700 group-hover:scale-105">
					<img src="/images/plato_estrella.png" alt="Plato Estrella" class="w-full h-full object-cover opacity-60" />
				</div>
				<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 to-transparent"></div>
				<div class="relative z-10">
					<span class="bg-brand-600 text-white text-xs px-3 py-1 uppercase tracking-wider mb-4 inline-block">Plato Estrella</span>
					<h3 class="text-3xl font-bold text-white mb-2">Merluza Austral Curada</h3>
					<p class="text-zinc-400 mb-4 max-w-md">Emulsión de cochayuyo, polvo de merkén ahumado y salicornia de la costa central.</p>
					<a href="/menu" class="text-brand-500 font-medium hover:text-white transition-colors flex items-center gap-2">Explorar Carta <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
				</div>
			</div>

			<!-- Info Bento 1 -->
			<div class="md:col-span-2 relative bg-zinc-900 border border-zinc-800 p-8 flex flex-col justify-center group overflow-hidden">
				<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-zinc-800 to-transparent opacity-50"></div>
				<div class="relative z-10">
					<h3 class="text-2xl font-bold text-white mb-2">Menú Degustación</h3>
					<p class="text-zinc-400 mb-6">7 tiempos que recorren Chile de norte a sur. Maridaje disponible con viñas boutique nacionales.</p>
					<div class="flex items-end justify-between">
						<span class="text-xl font-bold text-brand-500">$65.000 <span class="text-sm font-normal text-zinc-500">p/p</span></span>
						<a href="/reservas" class="border-b border-zinc-500 hover:border-white transition-colors pb-1 text-sm uppercase tracking-widest">Reservar</a>
					</div>
				</div>
			</div>

			<!-- Info Bento 2 -->
			<div class="relative bg-zinc-900 border border-zinc-800 p-8 flex flex-col justify-center group overflow-hidden text-center">
				<div class="w-12 h-12 bg-zinc-800 mx-auto rounded-full flex items-center justify-center text-brand-500 mb-4">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
				</div>
				<h3 class="text-white font-bold mb-2">Pago Fácil</h3>
				<p class="text-zinc-400 text-sm">Aceptamos todas las tarjetas. Propinas directamente al equipo.</p>
			</div>

			<!-- Info Bento 3 -->
			<div class="relative bg-zinc-900 border border-zinc-800 p-8 flex flex-col justify-center overflow-hidden group">
				<div class="absolute inset-0 transition-transform duration-700 group-hover:scale-110 opacity-30">
					<img src="/images/coctel.png" alt="Coctel" class="w-full h-full object-cover" />
				</div>
				<div class="relative z-10 text-center">
					<h3 class="text-white font-bold mb-2">Coctelería</h3>
					<p class="text-zinc-400 text-sm">Destilados chilenos.</p>
				</div>
			</div>

		</div>
	</section>

	<!-- Google Reviews Mock -->
	<section class="py-16 border-t border-zinc-900 bg-zinc-950/50">
		<div class="max-w-7xl mx-auto px-6">
			<div class="flex items-center justify-center gap-2 mb-8 text-amber-500">
				★★★★★ <span class="text-white ml-2 text-lg">4.9 en Google</span>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<div class="bg-zinc-900 p-6 border border-zinc-800">
					<p class="text-zinc-300 italic mb-4">"La mejor experiencia gastronómica que he tenido en Santiago. El uso del fuego es magistral."</p>
					<p class="text-sm text-zinc-500">- Valentina S.</p>
				</div>
				<div class="bg-zinc-900 p-6 border border-zinc-800">
					<p class="text-zinc-300 italic mb-4">"Atención impecable y sabores que sorprenden. El maridaje es un viaje por Chile."</p>
					<p class="text-sm text-zinc-500">- Diego M.</p>
				</div>
				<div class="bg-zinc-900 p-6 border border-zinc-800">
					<p class="text-zinc-300 italic mb-4">"Increíble relación calidad-precio para alta cocina. Recomendado para ocasiones especiales."</p>
					<p class="text-sm text-zinc-500">- Camila R.</p>
				</div>
			</div>
		</div>
	</section>
</Layout>
